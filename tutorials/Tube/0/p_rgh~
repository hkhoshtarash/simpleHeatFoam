FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;


boundaryField
{
    frontAndBack
    {
        type            empty;
    }
    square
    {
        type            fixedFluxPressure;
        gradient        uniform 0;
    }
    cylinder
    {
        type            fixedFluxPressure;
        gradient        uniform 0;
    }
}


