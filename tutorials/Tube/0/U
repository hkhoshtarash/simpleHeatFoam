FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0.005);


boundaryField
{
    inlet
    {

        type            fixedValue;
        value           uniform (0 0 0.005);

    }
    outlet
    {
                type            zeroGradient;
    }
     tube
    {
        type           noSlip;
    }
    front
    {
        type            wedge;     
    }
    back
    {
        type            wedge;  
    }
    axis
    {
        type            empty;
    }
}


